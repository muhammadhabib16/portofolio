    type: 'Organisasi & Rekayasa Mobile',
    responsibilities: [
      'Mengoordinasikan dan mengelola pemenuhan kebutuhan operasional dan administratif guna memastikan kelancaran seluruh program kerja UKM.',
      'Berkontribusi langsung sebagai tim pengembang dalam perancangan dan pembuatan aplikasi mobile "Neo App".',
      'Bertindak sebagai mentor teknis dalam Bootcamp Android Mobile Development, membimbing peserta dalam menguasai perancangan aplikasi menggunakan Kotlin dan Android Studio.',
    ],
    tech: ['Flutter', 'Kotlin', 'Android Studio', 'Mobile Architecture', 'Team Leadership'],
  },
  {
    role: 'Mentor Mobile Developer',
    organization: 'Metro Institute — Padang',
    period: 'Sep 2026 — Sekarang',
    type: 'Pendidikan & Mentoring Industri',
    responsibilities: [
      'Mengembangkan silabus terstruktur dan modul ajar komprehensif untuk memfasilitasi kelas Mobile Development.',
      'Mengajar dan membimbing siswa dalam praktik implementasi state management, pemanggilan REST API, dan integrasi UI responsif menggunakan framework Flutter.',
    ],
    tech: ['Flutter', 'Dart', 'Curriculum Design', 'Technical Mentoring', 'Code Review'],
  },
  {
    role: 'Staff Penelitian dan Pengembangan',
    organization: 'Laboratorium System Development — Padang',
    period: 'Aug 2025 — Sekarang',
    type: 'Akademik & Riset Laboratorium',
    responsibilities: [
      'Merancang modul pembelajaran komprehensif sekaligus mengampu sesi praktikum untuk mata kuliah Dasar-Dasar Pemrograman dan Struktur Data & Algoritma.',
      'Membangun infrastruktur digital laboratorium secara end-to-end dengan mengembangkan Website Profile interaktif dan Sistem Manajemen Jadwal Piket Asisten.',
    ],
    tech: ['Data Structures', 'Algorithm Design', 'Full-Stack Web', 'Laboratory Management'],
  },
  {
    role: 'Full Stack Developer',
    organization: 'Departemen Proteksi Tanaman — Universitas Andalas',
    period: 'Nov 2025 — Feb 2026',
    type: 'Pengembangan Web & Infrastruktur Server',
    responsibilities: [
      'Mengembangkan Website Profile Departemen Proteksi Tanaman secara komprehensif dari tahap arsitektur UI hingga backend data.',
      'Mengeksekusi proses deployment ke server Universitas Andalas menggunakan arsitektur kontainer berbasis Docker di lingkungan Linux.',
    ],
