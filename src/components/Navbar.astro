---
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const navLinks = [
  { name: 'About', href: '/#about' },
  { name: 'Projects', href: '/projects' },
  { name: 'Experience', href: '/#experience' },
  { name: 'Resume', href: '/Muhammad%20Habib-resume.pdf', external: true },
];
---

<header class="sticky top-0 z-50 w-full border-b border-light-border dark:border-dark-border bg-light-bg/85 dark:bg-dark-bg/85 backdrop-blur-md transition-colors">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between">
    <!-- Terminal Brand Title -->
    <a
      href="/"
      class="group flex items-center gap-2 font-mono text-sm tracking-tight font-semibold text-light-text dark:text-dark-text hover:text-light-accent dark:hover:text-dark-accent transition-colors"
    >
      <span class="text-light-accent dark:text-dark-accent">❯</span>
      <span>~/muhammad-habib</span>
      <span class="inline-block w-2 h-4 bg-light-accent dark:bg-dark-accent animate-pulse"></span>
    </a>

    <!-- Navigation Links & Theme Toggle -->
    <div class="flex items-center gap-1 sm:gap-2">
      <nav class="flex items-center gap-1 sm:gap-2">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noopener noreferrer' : undefined}
              class={`px-3 py-1.5 rounded-md font-mono text-xs sm:text-sm font-medium transition-colors ${
                isActive
                  ? 'text-light-accent dark:text-dark-accent bg-light-accent/10 dark:bg-dark-accent/10 font-semibold'
                  : 'text-light-muted dark:text-dark-muted hover:text-light-text dark:hover:text-dark-text hover:bg-light-surface-hover dark:hover:bg-dark-surface-hover'
              }`}
            >
              {link.name}
              {link.external && <span class="text-[10px] ml-0.5 opacity-70">↗</span>}
            </a>
          );
        })}
      </nav>

      <div class="h-4 w-px bg-light-border dark:bg-dark-border mx-1"></div>

      <!-- Theme Switcher -->
      <ThemeToggle />
    </div>
  </div>
</header>
