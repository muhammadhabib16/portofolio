---
const techGroups = [
  {
    category: 'Web & API Systems',
    description: 'Arsitektur backend modular, RESTful API, dan web reaktif terstruktur',
    skills: [
      { name: 'Next.js & React', detail: 'App Router, SSR, Server Components' },
      { name: 'Express / Node.js', detail: 'REST APIs, Middleware, WebSockets' },
      { name: 'Laravel (PHP)', detail: 'MVC, Eloquent ORM, RBAC Services' },
      { name: 'TypeScript', detail: 'Type-safe contracts & schema validation' },
      { name: 'PostgreSQL & MySQL', detail: 'Indexing, ACID Transactions, Complex Joins' },
      { name: 'Redis', detail: 'Caching, Pub/Sub, Worker Queue management' },
    ],
  },
  {
    category: 'Mobile & Spatial Engineering',
    description: 'Aplikasi performa tinggi lintas platform & komputasi geospasial luring',
    skills: [
      { name: 'Flutter & Dart', detail: 'BLoC pattern, State Management, Custom Canvas' },
      { name: 'QGIS & SpatiaLite', detail: 'Pembersihan topologi & kompresi vektor GIS' },
      { name: 'Spatial Routing', detail: 'A* & Dijkstra graph routing pada peta offline' },
      { name: 'Hardware Sensor Fusion', detail: 'Integrasi Kompas, Akselerometer, & GPS Fix' },
      { name: 'SQLite / MBTiles', detail: 'Penyimpanan lokal resolusi tinggi offline-first' },
      { name: 'OpenStreetMap (OSM)', detail: 'Ekstraksi layer jalan & poligon batas wilayah' },
    ],
  },
  {
    category: 'Infrastructure & DevOps',
    description: 'Containerization, otomasi deployment VPS, dan administrasi Linux',
    skills: [
      { name: 'Linux (Ubuntu/Debian)', detail: 'Bash scripting, systemd, memory tuning' },
      { name: 'Docker & Compose', detail: 'Multi-stage builds, isolated container clusters' },
      { name: 'Nginx Reverse Proxy', detail: 'SSL hardening, rate-limiting, load balancing' },
      { name: 'VPS Deployment', detail: 'Production orchestration di DigitalOcean & AWS' },
      { name: 'Git & CI/CD Pipelines', detail: 'Automated testing & zero-downtime deployment' },
      { name: 'Monitoring & Telemetry', detail: 'Log rotation, Prometheus metrics, Uptime' },
    ],
  },
];
---

<section id="skills" class="space-y-6">
  <div class="flex items-center justify-between border-b border-light-border dark:border-dark-border pb-3">
    <div class="flex items-center gap-2">
      <span class="font-mono text-xs text-light-accent dark:text-dark-accent">02.</span>
      <h2 class="font-mono text-sm uppercase tracking-wider font-semibold text-light-text dark:text-dark-text">
        Tech_Stack_Matrix
      </h2>
    </div>
    <span class="font-mono text-[11px] text-light-muted dark:text-dark-muted hidden sm:inline-block">
      // no progress bars, pure capabilities
    </span>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
    {techGroups.map((group) => (
      <div class="flex flex-col p-5 rounded-lg border border-light-border dark:border-dark-border bg-light-surface dark:bg-dark-surface">
        <div class="mb-4">
          <h3 class="font-mono text-sm font-semibold text-light-text dark:text-dark-text flex items-center gap-2">
            <span class="text-light-accent dark:text-dark-accent font-bold">#</span>
            {group.category}
          </h3>
          <p class="text-xs text-light-muted dark:text-dark-muted mt-1 leading-relaxed">
            {group.description}
          </p>
        </div>

        <ul class="space-y-2.5 flex-grow font-mono text-xs">
          {group.skills.map((skill) => (
            <li class="p-2 rounded bg-light-surface-hover dark:bg-dark-surface-hover border border-light-border-subtle dark:border-dark-border-subtle">
              <div class="flex items-center justify-between">
                <span class="font-medium text-light-text dark:text-dark-text">{skill.name}</span>
                <span class="text-[10px] text-light-accent dark:text-dark-accent">PROD</span>
              </div>
              <p class="text-[11px] text-light-muted dark:text-dark-muted mt-0.5 font-sans">
                {skill.detail}
              </p>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
