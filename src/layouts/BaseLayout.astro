---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  article?: boolean;
}

const {
  title = 'Muhammad Habib | Software Engineer & Informatics Student',
  description = 'Portofolio rekayasa perangkat lunak Muhammad Habib: Full-stack web, mobile Flutter, spatial GIS, dan sistem infrastruktur.',
  ogImage = '/og-image.png',
  article = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://habib.dev');
---

<!doctype html>
<html lang="id" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <!-- SEO Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Muhammad Habib" />
    <meta name="theme-color" content="#090a0f" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, canonicalURL)} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(ogImage, canonicalURL)} />

    <!-- Zero-FOUC Theme Script: runs immediately in head before DOM paint -->
    <script is:inline>
      (function () {
        const storedTheme = typeof localStorage !== 'undefined' ? localStorage.getItem('theme') : null;
        if (storedTheme === 'light') {
          document.documentElement.classList.remove('dark');
        } else if (storedTheme === 'dark') {
          document.documentElement.classList.add('dark');
        } else {
          // Default to Dark Mode as specified in PRD section 2
          document.documentElement.classList.add('dark');
        }
      })();
    </script>
  </head>
  <body class="tech-grid-bg min-h-screen flex flex-col justify-between">
    <Navbar currentPath={Astro.url.pathname} />

    <main class="flex-grow max-w-5xl w-full mx-auto px-4 sm:px-6 py-8 sm:py-12">
      <slot />
    </main>

    <Footer />
  </body>
</html>
